+def _execution_file(d, name, jobs, items, exploratory=False, plan=False, in_force=True, not_evaluable=()):
+    (d / "execution").mkdir(parents=True, exist_ok=True)
+
+    def entry(i, key, reading, flag, ln, grounds):
+        return dict(item=f"point {i}", key=key, reading=reading, flag=flag, flags=["element over a cut elsewhere in the cone"] if flag else [], grounds=grounds, ln_ratio=ln,
+                    reason=f"reason {i}", elements=[dict(kind="qubit", qubit=31, reasons=["readout"], zone="cone")] if flag else [], settings_sha256="0" * 64)
+    (d / "execution" / name).write_text(json.dumps(dict(
+        list="syn", exploratory=exploratory, plan_only=plan, settings=dict(in_force=in_force),
+        groups=[dict(E="e" * 64 if "second" not in name else "f" * 64, jobs=[dict(job_id=j) for j in jobs],
+                     classification=[entry(i, key, reading, flag, ln, ["line"] if reading == "not_evaluable" else []) for i, (key, reading, flag, ln) in enumerate(items)])] if jobs else [],
+        not_evaluable=[dict(job_id=j, why="no update published at or after finished yet",
+                            classification=[entry(i, key, "not_evaluable", False, None, ["no_execution_calibration"]) for i, key in enumerate(keys)]) for j, keys in not_evaluable])),
+        encoding="utf-8")
+
+
+def test_execution_readings_join_the_points_and_the_statistics_are_also_given_without_the_flagged_points(passing, tmp_path):
+    """Draft Deviation 65, analysis side: the committed readings are joined to the measured points on job ids and key; a run
+    without committed readings is read as before; the Deviation 19 statistics are repeated without the flagged points."""
+    from gradvar.analysis.report import execution_calibration, write_report
+    pts, cmp = passing["points"], passing["comparison"]
+    assert passing["execution_calibration"]["flagged_points"] == [] and passing["execution_calibration"]["anomaly_protocol_without_flagged"] is None
+    assert {e["source"] for e in passing["execution_calibration"]["readings"]} == {"none"}                 # nothing committed: nothing changes
+    pts = pts.copy()
+    r0 = pts[(pts.kind == "grid") & (pts.resilience_level == 0)].to_dict("records")       # the synthetic run puts them all in one job
+    r1 = pts[(pts.kind == "grid") & (pts.resilience_level == 1)].to_dict("records")       # and these in another
+    a, b, c, e = r0[0], r0[1], r0[2], r0[3]
+    job0, job1 = a["jobs"][0], r1[0]["jobs"][0]
+    assert all(r["jobs"] == [job0] for r in r0) and all(r["jobs"] == [job1] for r in r1) and job0 != job1
+    pts.at[pts.index[pts.point_id == c["point_id"]][0], "jobs"] = [job0, "second-job"]      # c is split over two jobs
+    key = lambda r: dict(kind="grid", arm="grid", n=int(r["n"]), L=int(r["L"]), k=int(r["k"]), p=None)   # noqa: E731
+    d = tmp_path / "pred"
+    _execution_file(d, "syn_eeeeeeeeeeee.json", [job0], [(key(r), "read_with_flag", True, 0.0105) if r is b else (key(r), "read", False, None) for r in r0 if r is not e])
+    _execution_file(d, "syn_second_ffffffffffff.json", ["second-job"], [(key(c), "not_evaluable", True, 0.21)])
+    _execution_file(d, "syn_exploratory.json", [job0], [(key(e), "not_evaluable", True, 0.5)], exploratory=True)
+    _execution_file(d, "syn_not_in_force.json", [job0], [(key(e), "not_evaluable", True, 0.5)], in_force=False)
+    _execution_file(d, "syn_plan.json", [job0], [(key(e), "not_evaluable", True, 0.5)], plan=True)
+    (d / "execution" / "syn_rerun_decision.json").write_text(json.dumps(dict(rerun=[], settings=dict(in_force=True))), encoding="utf-8")
+    _execution_file(d, "syn_not_evaluable.json", [], [], not_evaluable=[(job1, [key(r) for r in r1])])        # no calibration could be built for job1
+    preds = dict(passing["_preds"], execution=P.load_execution_readings(d))
+    assert len(preds["execution"]["readings"]) == len(r0) + len(r1)                           # the exploratory, not-in-force, plan and decision files are not read
+    assert [j["job_id"] for j in preds["execution"]["without_calibration"]] == [job1]
+    x = execution_calibration(pts, cmp, preds)
+    by = {r["point_id"]: r for r in x["readings"]}
+    assert by[a["point_id"]]["reading"] == "read" and by[a["point_id"]]["flag"] is False and by[a["point_id"]]["source"] == "syn_eeeeeeeeeeee.json"
+    assert by[b["point_id"]]["reading"] == "read_with_flag" and by[b["point_id"]]["flag"] is True and by[b["point_id"]]["ln_ratio"] == 0.0105
+    # the strictest classification among the jobs of a split point (C65-1)
+    assert by[c["point_id"]]["reading"] == "not_evaluable" and by[c["point_id"]]["split"] is True and by[c["point_id"]]["parts"] == 2 and by[c["point_id"]]["grounds"] == ["line"]
+    assert by[e["point_id"]]["source"] == "missing" and by[e["point_id"]]["flag"] is True and by[e["point_id"]]["reading"] is None   # its job has readings, it has none
+    for r in r1:                                                                             # their job has no execution-time calibration: not evaluable (C65-4)
+        g = by[r["point_id"]]
+        assert g["reading"] == "not_evaluable" and g["flag"] is True and g["grounds"] == ["no_execution_calibration"] and g["source"] == "syn_not_evaluable.json"
+    dial = pts[pts.kind == "reset_dial"].point_id.tolist()
+    assert dial and all(by[i]["source"] == "none" and by[i]["flag"] is False for i in dial)   # nothing committed for their jobs: read as before
+    flagged = sorted([b["point_id"], c["point_id"], e["point_id"]] + [r["point_id"] for r in r1])
+    assert sorted(x["flagged_points"]) == flagged and sorted(x["not_evaluable_points"]) == sorted([c["point_id"]] + [r["point_id"] for r in r1])
+    w = x["anomaly_protocol_without_flagged"]
+    assert w["left_out"] == flagged and w["n_compared"] == passing["anomaly_protocol"]["n_compared"] - int(np.isfinite(cmp[cmp.point_id.isin(flagged)].z).sum())
+    assert P.anomaly_protocol_without(cmp, []) is None and P.anomaly_protocol_without(cmp, ["absent"]) is None
+    md = write_report(dict(passing, execution_calibration=x), tmp_path, {}).read_text()
+    assert "### Execution-time calibration (Deviation 65)" in md and f"| {b['point_id']} | read_with_flag |" in md and f"without the {len(flagged)} flagged point(s)" in md
+    assert "Not evaluable on their execution-time calibration: " in md and "Jobs without an execution-time calibration (their points are not evaluable): " + job1 in md
+    assert "PI's decision" not in md                                                         # C65-3: nobody decides after the data
+    assert "Execution-time calibration" not in write_report(passing, tmp_path, {}).read_text()
