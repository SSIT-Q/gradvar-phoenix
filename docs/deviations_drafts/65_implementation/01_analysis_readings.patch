+# --------------------------------------------------------------------------- execution-time readings (draft Deviation 65)
+
+EXECUTION_DIR = "execution"
+READING_ORDER = {"read": 0, "read_with_flag": 1, None: 2, "not_evaluable": 3}      # the reading of a split point is its most restrictive part
+
+
+def load_execution_readings(directory: str | Path) -> Dict:
+    """What ``scripts/redraw_execution.py`` committed under ``<directory>/execution/`` before the results were retrieved:
+    ``readings``, one per (jobs on one execution-time calibration, measured item) with the item's ``key`` (kind, arm, n, L, k,
+    p), its reading, grounds, flags, ``ln_ratio`` and over-cut elements. The items of a job for which no calibration could be
+    built are readings too (not evaluable, ground ``no_execution_calibration``); those jobs are also listed in
+    ``without_calibration``. Plans, re-run decisions, files marked exploratory and files drawn while the settings table was
+    not in force are not read. No directory: both empty."""
+    d = Path(directory) / EXECUTION_DIR
+    readings, without = [], []
+
+    def add(f, res, jobs, E, c):
+        readings.append(dict(file=f.name, list=res.get("list"), jobs=jobs, E=E, key=c.get("key") or {}, item=c.get("item"), reading=c.get("reading"),
+                             flag=bool(c.get("flag")), flags=list(c.get("flags") or []), grounds=list(c.get("grounds") or []), ln_ratio=c.get("ln_ratio"),
+                             reason=c.get("reason"), elements=c.get("elements") or [], settings_sha256=c.get("settings_sha256")))
+    for f in sorted(d.glob("*.json")) if d.is_dir() else []:
+        if f.stem.endswith(("_plan", "_rerun_decision")):
+            continue
+        res = json.loads(f.read_text(encoding="utf-8"))
+        if res.get("plan_only") or res.get("exploratory") or (res.get("settings") or {}).get("in_force") is not True:
+            continue
+        for g in res.get("groups") or []:
+            jobs = sorted(str(j.get("job_id") if isinstance(j, dict) else j) for j in g.get("jobs") or [])
+            for c in g.get("classification") or []:
+                add(f, res, jobs, g.get("E"), c)
+        for j in res.get("not_evaluable") or []:
+            without.append(dict(file=f.name, list=res.get("list"), job_id=str(j.get("job_id")), why=j.get("why")))
+            for c in j.get("classification") or []:
+                add(f, res, [str(j.get("job_id"))], None, c)
+    return dict(readings=readings, without_calibration=without)
+
+
+def _reading_is_for(key: Dict, r: Dict) -> bool:
+    """Whether a reading's key names the point ``r`` of the point table."""
+    try:
+        if DIAL_KIND.get(str(key.get("arm")), str(key.get("arm"))) != DIAL_KIND.get(str(r.get("arm")), str(r.get("arm"))):
+            return False
+        if int(key["L"]) != int(r["L"]) or int(key["k"]) != int(r["k"]) or (key.get("n") is not None and int(key["n"]) != int(r["n"])):
+            return False
+        kp, rp = _num(key.get("p")), _num(r.get("p"))
+        return bool((not np.isfinite(kp) and not np.isfinite(rp)) or (np.isfinite(kp) and np.isfinite(rp) and abs(kp - rp) < 1e-9))
+    except (KeyError, TypeError, ValueError):
+        return False
+
+
+def execution_readings(points: pd.DataFrame, preds: Dict) -> List[Dict]:
+    """Draft Deviation 65: per measured point, its committed execution-time reading, joined on the point's job ids and its key.
+    ``source`` is ``"none"`` when nothing is committed for any of the point's jobs (a run from before the Deviation: the point
+    is read as it always was and is not counted as flagged). A point whose executions lie in jobs with different readings
+    (``split``) takes the strictest of them (C65-1): not evaluable, then unclassified, then read with a flag, then read. A
+    point is flagged, with no reading, when its jobs have committed readings but none for the point itself, and flagged when
+    one of its jobs is covered by no reading. ``flag`` is what the statistics without flagged points leave out."""
+    readings = (preds.get("execution") or {}).get("readings") or []
+    known = set().union(*[set(x["jobs"]) for x in readings]) if readings else set()
+    out = []
+    for r in points.to_dict("records") if len(points) else []:
+        if r.get("L") is None or r.get("k") is None or r.get("kind") == "null_control":
+            continue
+        jobs = {str(j) for j in (r.get("jobs") if isinstance(r.get("jobs"), (list, tuple, set)) else [])}
+        parts = [x for x in readings if jobs & set(x["jobs"]) and _reading_is_for(x["key"], r)]
+        if not parts and not (jobs & known):
+            out.append(dict(point_id=r["point_id"], source="none", reading=None, flag=False, split=False, parts=0, grounds=[], flags=[],
+                            note="no execution-time reading is committed for this point's jobs"))
+            continue
+        if not parts:
+            out.append(dict(point_id=r["point_id"], source="missing", reading=None, flag=True, split=False, parts=0, grounds=[], flags=[],
+                            reason="unclassified: the point's jobs have committed execution-time readings, but none for this point"))
+            continue
+        uncovered = sorted(jobs - set().union(*[set(x["jobs"]) for x in parts]))
+        worst = max(parts, key=lambda x: READING_ORDER.get(x["reading"], 2))
+        out.append(dict(point_id=r["point_id"], source=", ".join(sorted({x["file"] for x in parts})), reading=worst["reading"],
+                        flag=bool(any(x["flag"] for x in parts) or worst["reading"] != "read" or uncovered), grounds=sorted({g for x in parts for g in x["grounds"]}),
+                        flags=sorted({g for x in parts for g in x["flags"]}), ln_ratio=worst["ln_ratio"], reason=worst["reason"],
+                        split=len({(x["E"], x["reading"]) for x in parts}) > 1, parts=len(parts), elements=worst["elements"], jobs_without_reading=uncovered))
+    return out
+
+
+def anomaly_protocol_without(comparison: pd.DataFrame, point_ids) -> Dict | None:
+    """Draft Deviation 65: the Deviation 19 statistics of the same comparison table without the flagged points; ``None`` when
+    no compared point is flagged. Reported beside ``anomaly_protocol`` on the whole table, which stays the pre-registered one."""
+    left_out = sorted(set(point_ids) & set(comparison.point_id)) if len(comparison) else []
+    if not left_out:
+        return None
+    d = comparison[~comparison.point_id.isin(left_out)]
+    out = anomaly_protocol(d) if len(d) else dict(flagged=False, single_point=[], monotone_runs=[], n_compared=0)
+    out["left_out"] = left_out
     return out
 
 
